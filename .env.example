NODE_ENV=production
PORT=10000

# Database (Render provides this automatically if you attach a Postgres instance)
DATABASE_URL=postgres://...        # from Render's Postgres

# Public URL (used in email links, .ics, status page)
BASE_URL=https://your-app.onrender.com

# Session
SESSION_SECRET=<64+ random chars>   # generate: openssl rand -hex 32

# Admin login (bcrypt hash — generate locally, see §2)
ADMIN_EMAIL=you@405ink.com
ADMIN_PASSWORD_HASH=$2b$12$....................................

# SMTP (Brevo, Postmark, Resend, Gmail app password, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=you@smtp-brevo.com
SMTP_PASS=your-smtp-key
MAIL_FROM=405INK <no-reply@405ink.com>

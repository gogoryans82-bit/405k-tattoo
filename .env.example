# ── Email ─────────────────────────────────────────────────────
# Which provider to use: "smtp" | "brevo" | "resend"
MAIL_PROVIDER=smtp

# Sender / admin addresses (used by every provider)
MAIL_FROM="405INK Studio <noreply@yourdomain.com>"
MAIL_FROM_NAME="405INK Studio"
ADMIN_EMAIL=owner@yourdomain.com
PAYPAL_EMAIL=you@paypal.com

# ── Option A: SMTP ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# ── Option B: Brevo API ───────────────────────────────────────
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: custom IP for deliverability
# BREVO_SENDER_IP=

# ── Option C: Resend API ──────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
